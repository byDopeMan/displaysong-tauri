{
  "name": "displaysong",
  "version": "4.2.3",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check:all": "npm run typecheck && npm run check && cargo clippy --manifest-path src-tauri/Cargo.toml",
    "clean": "tsx scripts/clean.ts",
    "build": "tauri build",
    "build:signed": "tsx scripts/build-signed.ts",
    "build:updater": "tsx scripts/build-signed.ts --bundles msi,nsis,updater",
    "build:installer": "npm run build && npm run installer",
    "installer": "tsx scripts/build-installer.ts",
    "tauri": "tauri",
    "version": "tsx scripts/bump-version.ts",
    "changelog": "tsx scripts/bump-version.ts changelog",
    "zip": "tsx scripts/zip-release.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^2.5.3",
    "@tauri-apps/cli": "1.6.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.0.0",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "jimp": "^1.6.1",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^4.0.0"
  }
}
